{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer footer--atypical color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="footer__content-top page-width">
    <div class="atypical-footer__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'brand_information' -%}
              <div class="atypical-footer__col atypical-footer__col--brand" {{ block.shopify_attributes }}>
                <a href="{{ routes.root_url }}" class="atypical-footer__logo-link" aria-label="{{ shop.name }}">
                  {%- if section.settings.brand_logo != blank -%}
                    {%- assign logo_w = section.settings.brand_logo_width | default: 180 -%}
                    <img
                      src="{{ section.settings.brand_logo | image_url: width: logo_w }}"
                      alt="{{ section.settings.brand_logo.alt | default: shop.name | escape }}"
                      width="{{ logo_w }}"
                      height="{{ logo_w | divided_by: section.settings.brand_logo.aspect_ratio | round }}"
                      loading="lazy"
                      class="atypical-footer__logo-img"
                    >
                  {%- elsif settings.logo != blank -%}
                    {%- assign logo_w = section.settings.brand_logo_width | default: 180 -%}
                    <img
                      src="{{ settings.logo | image_url: width: logo_w }}"
                      alt="{{ settings.logo.alt | default: shop.name | escape }}"
                      width="{{ logo_w }}"
                      height="{{ logo_w | divided_by: settings.logo.aspect_ratio | round }}"
                      loading="lazy"
                      class="atypical-footer__logo-img"
                    >
                  {%- else -%}
                    <span class="atypical-footer__logo-wordmark">atypical</span>
                  {%- endif -%}
                </a>

                {%- assign brand_desc = settings.brand_description -%}
                {%- if brand_desc == blank -%}
                  {%- assign brand_desc = section.settings.brand_description -%}
                {%- endif -%}
                {%- if brand_desc != blank -%}
                  <div class="atypical-footer__description rte">
                    <p>{{ brand_desc }}</p>
                  </div>
                {%- endif -%}

                {%- if block.settings.show_social and settings.social_instagram_link != blank -%}
                  {%- render 'social-icons', class: 'atypical-footer__social-list' -%}
                {%- endif -%}
              </div>

            {%- when 'link_list' -%}
              <div class="atypical-footer__col atypical-footer__col--nav" {{ block.shopify_attributes }}>
                <h3 class="atypical-footer__heading">
                  {%- if block.settings.heading != blank -%}
                    {%- if block.settings.heading == 'Quick links' -%}
                      Info
                    {%- else -%}
                      {{ block.settings.heading }}
                    {%- endif -%}
                  {%- elsif block.settings.menu != blank -%}
                    {{ block.settings.menu.title }}
                  {%- else -%}
                    Menu
                  {%- endif -%}
                </h3>

                <ul class="atypical-footer__links list-unstyled">
                  {%- if block.settings.heading == 'Info' or block.settings.heading == 'Quick links' -%}
                    {%- if block.settings.menu != blank and block.settings.menu != 'footer' and linklists[block.settings.menu].links.size > 0 -%}
                      {%- for link in linklists[block.settings.menu].links -%}
                        <li>
                          <a href="{{ link.url }}" class="atypical-footer__link">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    {%- else -%}
                      <li><a href="{{ routes.account_url }}" class="atypical-footer__link">Orders</a></li>
                      <li><a href="{{ routes.account_url }}" class="atypical-footer__link">Profile</a></li>
                    {%- endif -%}
                  {%- elsif block.settings.heading == 'Shop' -%}
                    {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                      {%- for link in linklists[block.settings.menu].links -%}
                        <li>
                          <a href="{{ link.url }}" class="atypical-footer__link">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    {%- else -%}
                      <li><a href="/collections/oversized-tshirts" class="atypical-footer__link">Tshirts</a></li>
                      <li><a href="/collections/shirts" class="atypical-footer__link">Shirts</a></li>
                      <li><a href="/collections/waffle-knits" class="atypical-footer__link">Winters</a></li>
                    {%- endif -%}
                  {%- elsif block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}" class="atypical-footer__link">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    <li><a href="/collections/oversized-tshirts" class="atypical-footer__link">Tshirts</a></li>
                    <li><a href="/collections/shirts" class="atypical-footer__link">Shirts</a></li>
                    <li><a href="/collections/waffle-knits" class="atypical-footer__link">Winters</a></li>
                  {%- endif -%}
                </ul>
              </div>

            {%- when 'text' -%}
              <div class="atypical-footer__col atypical-footer__col--text" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="atypical-footer__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <div class="atypical-footer__description rte">
                  {{ block.settings.subtext }}
                </div>
              </div>

            {%- when 'image' -%}
              <div class="atypical-footer__col atypical-footer__col--image" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: block.settings.image_width }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image_width }}"
                    height="{{ block.settings.image_width | divided_by: block.settings.image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Default fallback 3-column layout when no blocks are added -->
        <div class="atypical-footer__col atypical-footer__col--brand">
          <a href="{{ routes.root_url }}" class="atypical-footer__logo-link" aria-label="{{ shop.name }}">
            {%- if section.settings.brand_logo != blank -%}
              {%- assign logo_w = section.settings.brand_logo_width | default: 180 -%}
              <img
                src="{{ section.settings.brand_logo | image_url: width: logo_w }}"
                alt="{{ section.settings.brand_logo.alt | default: shop.name | escape }}"
                width="{{ logo_w }}"
                height="{{ logo_w | divided_by: section.settings.brand_logo.aspect_ratio | round }}"
                loading="lazy"
                class="atypical-footer__logo-img"
              >
            {%- elsif settings.logo != blank -%}
              {%- assign logo_w = section.settings.brand_logo_width | default: 180 -%}
              <img
                src="{{ settings.logo | image_url: width: logo_w }}"
                alt="{{ settings.logo.alt | default: shop.name | escape }}"
                width="{{ logo_w }}"
                height="{{ logo_w | divided_by: settings.logo.aspect_ratio | round }}"
                loading="lazy"
                class="atypical-footer__logo-img"
              >
            {%- else -%}
              <span class="atypical-footer__logo-wordmark">atypical</span>
            {%- endif -%}
          </a>
          {%- assign brand_desc = settings.brand_description -%}
          {%- if brand_desc == blank -%}
            {%- assign brand_desc = section.settings.brand_description -%}
          {%- endif -%}
          {%- if brand_desc != blank -%}
            <div class="atypical-footer__description rte">
              <p>{{ brand_desc }}</p>
            </div>
          {%- endif -%}
        </div>

        <div class="atypical-footer__col atypical-footer__col--nav">
          <h3 class="atypical-footer__heading">{{ section.settings.shop_heading | default: 'Shop' }}</h3>
          <ul class="atypical-footer__links list-unstyled">
            <li><a href="/collections/oversized-tshirts" class="atypical-footer__link">Tshirts</a></li>
            <li><a href="/collections/shirts" class="atypical-footer__link">Shirts</a></li>
            <li><a href="/collections/waffle-knits" class="atypical-footer__link">Winters</a></li>
          </ul>
        </div>

        <div class="atypical-footer__col atypical-footer__col--nav">
          <h3 class="atypical-footer__heading">{{ section.settings.info_heading | default: 'Info' }}</h3>
          <ul class="atypical-footer__links list-unstyled">
            <li><a href="{{ routes.account_url }}" class="atypical-footer__link">Orders</a></li>
            <li><a href="{{ routes.account_url }}" class="atypical-footer__link">Profile</a></li>
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="atypical-footer__bottom page-width">
    <div class="atypical-footer__bottom-left">
      {%- if section.settings.policies_label != blank -%}
        <a href="{{ section.settings.policies_link | default: '/policies/terms-of-service' }}" class="atypical-footer__policy-link">
          {{ section.settings.policies_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="atypical-footer__bottom-center">
      {%- if section.settings.show_floating_button -%}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="atypical-footer__pill-btn">
          <span class="atypical-footer__pill-icon">
            <svg class="atypical-footer__pill-sparkles" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 3C14 6.8 17.2 10 21 10C17.2 10 14 13.2 14 17C14 13.2 10.8 10 7 10C10.8 10 14 6.8 14 3Z" fill="white"/>
              <path d="M7 13C7 15.2 8.8 17 11 17C8.8 17 7 18.8 7 21C7 18.8 5.2 17 3 17C5.2 17 7 15.2 7 13Z" fill="white"/>
            </svg>
          </span>
          <span class="atypical-footer__pill-text">{{ section.settings.button_text }}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="atypical-footer__bottom-right">
      <small class="atypical-footer__copyright">
        {%- assign raw_copyright = section.settings.copyright_text -%}
        {%- if raw_copyright contains 'Think Grow Media' -%}
          {%- assign copyright_parts = raw_copyright | split: 'Think Grow Media' -%}
          {{ copyright_parts[0] }}<a href="https://www.thinkgrowmedia.com" target="_blank" rel="noopener noreferrer" class="atypical-footer__credit-link">Think Grow Media(www.thinkgrowmedia.com)</a>
        {%- elsif raw_copyright != blank -%}
          {{ raw_copyright }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }} ATYPICAL | Designed and Managed by <a href="https://www.thinkgrowmedia.com" target="_blank" rel="noopener noreferrer" class="atypical-footer__credit-link">Think Grow Media(www.thinkgrowmedia.com)</a>
        {%- endif -%}
      </small>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_footer",
      "default": true,
      "label": "Enable Editorial Streetwear Footer",
      "info": "Displays the 3-column layout (Brand, Shop, Info) with floating Best Sellers pill button matching the reference design."
    },
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo"
    },
    {
      "type": "range",
      "id": "brand_logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 170
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Atypical Clothing is a premium Indian streetwear brand offering oversized t-shirts, hoodies, co-ord sets, and everyday essentials designed for modern creators and trendsetters. Crafted with premium fabrics, unique designs, and superior comfort, Atypical delivers high-quality fashion for those who choose to stand out instead of blending in."
    },
    {
      "type": "header",
      "content": "Shop Column"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop Menu (Optional)",
      "info": "Leave empty to use default links (Tshirts, Shirts, Winters)."
    },
    {
      "type": "header",
      "content": "Info Column"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Heading",
      "default": "Info"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "Info Menu (Optional)",
      "info": "Leave empty to use default links (Orders, Profile)."
    },
    {
      "type": "header",
      "content": "Floating Button (Shop Best Sellers)"
    },
    {
      "type": "checkbox",
      "id": "show_floating_button",
      "default": true,
      "label": "Show Floating Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "policies_label",
      "label": "Policies Label",
      "default": "Terms and Policies"
    },
    {
      "type": "url",
      "id": "policies_link",
      "label": "Policies Link"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 ATYPICAL | Designed and Managed by Think Grow Media(www.thinkgrowmedia.com)"
    },
    {
      "type": "header",
      "content": "Standard Footer Settings"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "info": "t:sections.footer.settings.enable_follow_on_shop.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "t:sections.footer.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "text"
      }
    ]
  }
}
{% endschema %}
