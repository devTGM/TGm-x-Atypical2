{%- comment -%}
  Shoppable Reels Section
  Renders a video slider carousel where each slide contains a Shoppable Reel (MP4 video).
  Each reel features a linked product card positioned below the video slide.
  Fully integrated with Dawn & Atypical color schemes, typography, and responsive controls.
{%- endcomment -%}

{%- liquid
  assign font_size = section.settings.font_size
  assign heading_alignment = section.settings.heading_alignment
  assign text_transform = section.settings.text_transform
  assign auto_rotate = section.settings.auto_rotate
  assign auto_rotate_speed = section.settings.auto_rotate_speed | times: 1000
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shoppable-reels-section-{{ section.id }} {
    background: transparent;
    color: rgb(var(--color-foreground));
  }

  .reels-header-{{ section.id }} {
    text-align: {{ heading_alignment }};
    margin-bottom: 28px;
  }

  .reels-title-{{ section.id }} {
    font-size: {{ font_size }}px;
    font-weight: 700 !important;
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: {{ text_transform }};
    color: rgb(var(--color-foreground));
  }

  .reels-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .reels-grid-scroll {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 8px 4px 16px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  .reels-grid-scroll::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
  }

  .reel-slide-card {
    flex: 0 0 calc(20% - 15px);
    min-width: 240px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: transparent;
    transition: transform 0.25s ease;
  }

  .reel-slide-card:hover {
    transform: translateY(-4px);
  }

  .reel-video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 9/16;
    border-radius: 14px;
    overflow: hidden;
    background-color: #141414;
    border: 1px solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 6px 20px -4px rgba(0, 0, 0, 0.55);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .reel-slide-card:hover .reel-video-container {
    border-color: rgba(var(--color-foreground), 0.22);
    box-shadow: 0 10px 28px -4px rgba(0, 0, 0, 0.75);
  }

  .reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 14px;
  }

  .reel-video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #181818;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .reel-mute-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    background: rgba(18, 18, 18, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    padding: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .reel-mute-btn:hover {
    background: rgba(18, 18, 18, 0.9);
    transform: scale(1.08);
  }

  .reel-product-card {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: opacity 0.2s ease;
  }

  .reel-product-card:hover {
    opacity: 0.85;
  }

  .reel-product-title {
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    color: rgb(var(--color-foreground));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .reel-product-price {
    font-size: 13px;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .reels-nav-btn {
    position: absolute;
    top: calc(50% - 20px);
    transform: translateY(-50%);
    background: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .reels-nav-btn:hover {
    background: #ffffff;
    color: #121212;
    transform: translateY(-50%) scale(1.08);
  }

  .reels-nav-prev {
    left: 8px;
  }

  .reels-nav-next {
    right: 8px;
  }

  @media screen and (min-width: 1200px) {
    .reels-nav-prev {
      left: -20px;
    }
    .reels-nav-next {
      right: -20px;
    }
  }

  @media (max-width: 1024px) {
    .reel-slide-card {
      flex: 0 0 calc(33.333% - 12px);
      min-width: 210px;
    }
  }

  @media (max-width: 768px) {
    .reel-slide-card {
      flex: 0 0 calc(50% - 9px);
      min-width: 165px;
    }
    .reels-nav-btn {
      display: none;
    }
    .reels-grid-scroll {
      padding: 6px 12px 14px;
      gap: 14px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="shoppable-reels-section-{{ section.id }} section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <div class="reels-header-{{ section.id }}">
          <h2 class="reels-title-{{ section.id }}">{{ section.settings.title }}</h2>
        </div>
      {%- endif -%}

      <div class="reels-carousel-wrapper" id="reels-{{ section.id }}">
        <button class="reels-nav-btn reels-nav-prev" aria-label="Previous Slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="reels-grid-scroll reels-track">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            <div class="reel-slide-card" {{ block.shopify_attributes }}>
              <div class="reel-video-container">
                {%- if block.settings.video_url != blank -%}
                  <video 
                    class="reel-video" 
                    src="{{ block.settings.video_url }}" 
                    loop 
                    muted 
                    autoplay
                    playsinline
                    preload="metadata"
                  ></video>
                  <button class="reel-mute-btn" aria-label="Mute Video">
                    <svg class="mute-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <line x1="23" y1="9" x2="17" y2="15"></line>
                      <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                  </button>
                {%- else -%}
                  <div class="reel-video-placeholder">
                    <span>No Video Linked</span>
                  </div>
                {%- endif -%}
              </div>

              {%- if product != blank -%}
                <a href="{{ product.url }}" class="reel-product-card">
                  <h4 class="reel-product-title">{{ product.title }}</h4>
                  <p class="reel-product-price">{{ product.price | money }}</p>
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <button class="reels-nav-btn reels-nav-next" aria-label="Next Slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const initCarousel = (wrapper) => {
      if (wrapper.dataset.reelsInitialized === 'true') return;
      wrapper.dataset.reelsInitialized = 'true';

      const track = wrapper.querySelector('.reels-track');
      const prev = wrapper.querySelector('.reels-nav-prev');
      const next = wrapper.querySelector('.reels-nav-next');
      if (!track || !prev || !next) return;

      const getScrollAmount = () => {
        const firstCard = track.querySelector('.reel-slide-card');
        return firstCard ? firstCard.clientWidth + 18 : 260;
      };

      const handleNextScroll = () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (Math.ceil(track.scrollLeft) >= maxScroll - 10) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        }
      };

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        resetAutoRotate();
      });

      next.addEventListener('click', () => {
        handleNextScroll();
        resetAutoRotate();
      });

      const isAutoRotate = {{ auto_rotate | json }};
      const autoRotateSpeed = {{ auto_rotate_speed | json }};
      let autoRotateInterval;

      const resetAutoRotate = () => {
        if (!isAutoRotate) return;
        clearInterval(autoRotateInterval);
        autoRotateInterval = setInterval(handleNextScroll, autoRotateSpeed);
      };

      if (isAutoRotate) {
        autoRotateInterval = setInterval(handleNextScroll, autoRotateSpeed);
      }
    };

    const handleVideoInteractions = () => {
      const videos = document.querySelectorAll('.reel-video');
      
      videos.forEach((video) => {
        if (video.dataset.videoHandled === 'true') return;
        video.dataset.videoHandled = 'true';

        const parent = video.closest('.reel-video-container');
        const muteBtn = parent ? parent.querySelector('.reel-mute-btn') : null;

        video.play().catch(() => {});

        if (parent) {
          parent.addEventListener('click', (e) => {
            if (e.target.closest('.reel-mute-btn')) return;
            if (video.paused) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        }

        if (muteBtn) {
          muteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            video.muted = !video.muted;
            
            if (video.muted) {
              muteBtn.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
              `;
            } else {
              muteBtn.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                </svg>
              `;
            }
          });
        }
      });
    };

    const initAll = () => {
      document.querySelectorAll('.reels-carousel-wrapper').forEach(initCarousel);
      handleVideoInteractions();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', (e) => {
      const wrapper = e.target.querySelector('.reels-carousel-wrapper');
      if (wrapper) {
        wrapper.dataset.reelsInitialized = 'false';
        initCarousel(wrapper);
      }
      handleVideoInteractions();
    });
  })();
</script>

{% schema %}
{
  "name": "Shoppable Reels",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop the Collection Live"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Heading Font Size",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Heading Case",
      "options": [
        {
          "value": "none",
          "label": "As written"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Auto Rotation Controls"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Enable Auto Rotation",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_rotate_speed",
      "label": "Rotation Speed (Seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Shoppable Reel",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video MP4 URL",
          "info": "Upload an MP4 under Content > Files and paste the URL here."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Reels",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
