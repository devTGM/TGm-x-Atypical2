{% comment %}
  Renders the Size Guide Modal dialog
  Usage:
  {% render 'product-size-guide', product: product %}
{% endcomment %}

{%- liquid
  assign size_chart_image = nil

  # The Size chart should be the last image of every product
  for media in product.media reversed
    if media.media_type == 'image'
      assign size_chart_image = media
      break
    endif
  endfor

  if size_chart_image == nil and product.images.size > 0
    assign size_chart_image = product.images.last
  endif
-%}

<div id="size-guide-modal-{{ product.id }}" class="size-guide-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="size-guide-heading-{{ product.id }}">
  <div class="size-guide-modal__backdrop" onclick="closeSizeGuideModal('{{ product.id }}')"></div>
  <div class="size-guide-modal__content">
    <div class="size-guide-modal__inner">
      <div class="size-guide-modal__header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.3 8.25a2.25 2.25 0 0 0-3-3l-13.5 13.5a2.25 2.25 0 0 0 3 3l13.5-13.5z"/>
            <path d="M12 9l1.5 1.5M9 12l1.5 1.5M6 15l1.5 1.5M15 6l1.5 1.5"/>
          </svg>
          <h2 id="size-guide-heading-{{ product.id }}" class="size-guide-modal__title">Size Chart</h2>
        </div>
        <button type="button" class="size-guide-modal__close" onclick="closeSizeGuideModal('{{ product.id }}')" aria-label="Close size chart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="size-guide-modal__body">
        {%- if size_chart_image != blank -%}
          <div class="size-guide-image-container">
            <img
              src="{{ size_chart_image | image_url: width: 1400 }}"
              srcset="
                {{ size_chart_image | image_url: width: 600 }} 600w,
                {{ size_chart_image | image_url: width: 800 }} 800w,
                {{ size_chart_image | image_url: width: 1000 }} 1000w,
                {{ size_chart_image | image_url: width: 1400 }} 1400w
              "
              sizes="(min-width: 750px) 760px, 92vw"
              alt="{{ size_chart_image.alt | default: product.title | escape | append: ' Size Chart' }}"
              loading="lazy"
              class="size-guide-img"
              width="{{ size_chart_image.width | default: 1200 }}"
              height="{{ size_chart_image.height | default: 1200 }}"
            >
          </div>
          <p class="size-guide-tip"><strong>Fit Tip:</strong> Our streetwear fits relaxed & boxy. If you prefer a standard fit, choose one size down.</p>
        {%- else -%}
          <div class="size-guide-table-wrap">
            <h3 class="size-guide-table-title">Measurements (Inches)</h3>
            <table class="size-guide-table">
              <thead>
                <tr>
                  <th>Size</th>
                  <th>Chest (in)</th>
                  <th>Length (in)</th>
                  <th>Shoulder (in)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>XS</strong></td>
                  <td>40</td>
                  <td>27</td>
                  <td>20</td>
                </tr>
                <tr>
                  <td><strong>S</strong></td>
                  <td>42</td>
                  <td>28</td>
                  <td>21</td>
                </tr>
                <tr>
                  <td><strong>M</strong></td>
                  <td>44</td>
                  <td>29</td>
                  <td>22</td>
                </tr>
                <tr>
                  <td><strong>L</strong></td>
                  <td>46</td>
                  <td>30</td>
                  <td>23</td>
                </tr>
                <tr>
                  <td><strong>XL</strong></td>
                  <td>48</td>
                  <td>31</td>
                  <td>24</td>
                </tr>
                <tr>
                  <td><strong>2XL</strong></td>
                  <td>50</td>
                  <td>32</td>
                  <td>25</td>
                </tr>
              </tbody>
            </table>
            <p class="size-guide-tip"><strong>Fit Tip:</strong> Our streetwear fits relaxed & boxy. If you prefer a standard fit, choose one size down. All measurements are in inches.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .size-guide-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .size-guide-modal.is-open {
    display: flex;
    opacity: 1;
    visibility: visible;
  }
  .size-guide-modal__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .size-guide-modal__content {
    position: relative;
    background: #141414;
    color: #ffffff;
    border-radius: 16px;
    max-width: 760px;
    width: calc(100% - 32px);
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.14);
    z-index: 2;
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .size-guide-modal__inner {
    padding: 22px;
  }
  .size-guide-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 16px;
    color: #ffffff;
  }
  .size-guide-modal__title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    color: #ffffff;
    font-family: inherit;
  }
  .size-guide-modal__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: rgba(255, 255, 255, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }
  .size-guide-modal__close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: rotate(90deg);
  }
  .size-guide-image-container {
    text-align: center;
    margin-bottom: 12px;
    border-radius: 12px;
    overflow: hidden;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .size-guide-img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    object-fit: contain;
    border-radius: 8px;
  }
  .size-guide-table-wrap {
    margin-top: 16px;
  }
  .size-guide-table-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #ffffff;
  }
  .size-guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 12px;
    text-align: left;
  }
  .size-guide-table th {
    background: rgba(255, 255, 255, 0.06);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 10px 12px;
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .size-guide-table td {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
  }
  .size-guide-table td strong {
    color: #ffffff;
  }
  .size-guide-table tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }
  .size-guide-tip {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    margin: 8px 0 0;
  }
  @media screen and (max-width: 749px) {
    .size-guide-modal__inner {
      padding: 16px;
    }
    .size-guide-modal__content {
      width: calc(100% - 24px);
      max-height: 92vh;
    }
  }
</style>

<script>
  if (typeof window.openSizeGuideModal !== 'function') {
    window.openSizeGuideModal = function(productId) {
      const modal = document.getElementById('size-guide-modal-' + productId);
      if (modal) {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    };
  }

  if (typeof window.closeSizeGuideModal !== 'function') {
    window.closeSizeGuideModal = function(productId) {
      const modal = document.getElementById('size-guide-modal-' + productId);
      if (modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.size-guide-modal.is-open').forEach(function(modal) {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
        });
        document.body.style.overflow = '';
      }
    });
  }
</script>
