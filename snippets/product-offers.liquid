{% comment %}
  Renders the "REWARDS WITH PURCHASE" offers container
  Usage:
  {% render 'product-offers', block: block %}
{% endcomment %}

<div class="rewards-offers-container" {{ block.shopify_attributes }}>
  <div class="rewards-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
    </svg>
    <span>{{ block.settings.title | default: 'REWARDS WITH PURCHASE' }}</span>
  </div>

  <div class="offers-grid">
    <div class="offer-card">
      <span class="offer-badge">{{ block.settings.offer1_badge | default: 'PREPAID' }}</span>
      <span class="offer-amount">{{ block.settings.offer1_text | default: '5% OFF' }}</span>
    </div>

    <div class="offer-card">
      <span class="offer-badge">{{ block.settings.offer2_badge | default: 'BUY 2' }}</span>
      <span class="offer-amount">{{ block.settings.offer2_text | default: '₹200 OFF' }}</span>
    </div>

    <div class="offer-card offer-card--featured">
      <span class="offer-badge">{{ block.settings.offer3_badge | default: 'BUY 3' }}</span>
      <span class="offer-amount">{{ block.settings.offer3_text | default: '₹400 OFF' }}</span>
    </div>
  </div>

  <div class="offers-footer">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span>{{ block.settings.footer_text | default: 'Auto-applied at checkout — no code needed' }}</span>
  </div>
</div>

<style>
  .rewards-offers-container {
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
    border-radius: 12px;
    padding: 16px;
    background-color: var(--color-background, #ffffff);
    margin-top: 18px;
    margin-bottom: 16px;
    box-shadow: 0 4px 12px rgba(var(--color-foreground-rgb, 0, 0, 0), 0.03);
    width: 100%;
    box-sizing: border-box;
  }
  .rewards-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: var(--color-foreground, #121212);
  }
  .rewards-header svg {
    flex-shrink: 0;
    color: var(--color-foreground, #121212);
  }
  .rewards-header span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground, #121212);
  }
  .offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .offer-card {
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
    border-radius: 8px;
    background-color: var(--color-background, #ffffff);
    padding: 10px 4px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }
  .offer-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--color-foreground-rgb, 0, 0, 0), 0.08);
  }
  .offer-card .offer-badge {
    font-size: 9px;
    font-weight: 600;
    color: var(--color-foreground-muted, #767676);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .offer-card .offer-amount {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-foreground, #121212);
  }
  .offer-card--featured {
    border: 1px solid var(--color-foreground, #000000);
    background-color: var(--color-foreground, #000000);
    color: var(--color-background, #ffffff);
  }
  .offer-card--featured .offer-badge {
    color: rgba(255, 255, 255, 0.85);
  }
  .offer-card--featured .offer-amount {
    color: #ffffff;
  }
  .offers-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-foreground-muted, #767676);
  }
  .offers-footer svg {
    flex-shrink: 0;
    color: var(--color-foreground, #121212);
  }
  .offers-footer span {
    font-size: 11px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-foreground-muted, #767676);
  }
</style>
