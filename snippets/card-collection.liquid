{% comment %}
  Renders a luxury streetwear collection card
  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio: {String} Size of the collection card. Values are "square" and "portrait". Default is "portrait"
  - columns: {Number}
  - extend_height: {Boolean}
  - wrapper_class: {String}
  - placeholder_image: {String}
{% endcomment %}

{%- liquid
  assign collection_image = card_collection.featured_image | default: card_collection.products.first.featured_image
  assign ratio = 0.75
  if collection_image and media_aspect_ratio == 'adapt'
    assign ratio = collection_image.aspect_ratio
  elsif collection_image and media_aspect_ratio == 'square'
    assign ratio = 1
  endif
  if ratio == 0 or ratio == null
    assign ratio = 0.75
  endif
-%}

<div class="card-wrapper collection-card-wrapper {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% endif %}">
  <div class="card collection-card media-card--overlap" style="--ratio-percent: {{ 1.0 | divided_by: ratio | times: 100 }}%;">
    <a
      {% if card_collection == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ card_collection.url }}"
      {% endif %}
      class="collection-card__link full-unstyled-link"
      aria-label="{{ card_collection.title | default: 'Collection' | escape }}"
    >
      <div class="collection-card__inner ratio" style="--ratio-percent: {{ 1.0 | divided_by: ratio | times: 100 }}%;">
        {%- if collection_image -%}
          <div class="collection-card__media media media--hover-effect">
            <img
              srcset="
                {%- if collection_image.width >= 165 -%}{{ collection_image | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if collection_image.width >= 330 -%}{{ collection_image | image_url: width: 330 }} 330w,{%- endif -%}
                {%- if collection_image.width >= 535 -%}{{ collection_image | image_url: width: 535 }} 535w,{%- endif -%}
                {%- if collection_image.width >= 750 -%}{{ collection_image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if collection_image.width >= 1000 -%}{{ collection_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                {%- if collection_image.width >= 1500 -%}{{ collection_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {{ collection_image | image_url }} {{ collection_image.width }}w
              "
              src="{{ collection_image | image_url: width: 800 }}"
              sizes="
                (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                calc((100vw - 3rem) / 2)
              "
              alt="{{ collection_image.alt | default: card_collection.title | escape }}"
              height="{{ collection_image.height }}"
              width="{{ collection_image.width }}"
              loading="lazy"
              class="motion-reduce collection-card__image"
            >
          </div>
        {%- else -%}
          <div class="collection-card__media placeholder-media">
            {{ placeholder_image | default: 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        <div class="collection-card__overlay"></div>

        <div class="collection-card__content">
          <div class="collection-card__details">
            <h3 class="collection-card__title">
              {%- if card_collection.title != blank -%}
                {{- card_collection.title | escape -}}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}
            </h3>
            {%- if card_collection.all_products_count and card_collection.all_products_count > 0 -%}
              <span class="collection-card__count">
                {{ card_collection.all_products_count }}
                {%- if card_collection.all_products_count == 1 %} Item{% else %} Items{% endif -%}
              </span>
            {%- endif -%}
          </div>
          <div class="collection-card__arrow-wrap">
            <svg class="collection-card__arrow" viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"/>
            </svg>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

