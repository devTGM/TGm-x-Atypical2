{% comment %}
  Renders the Luxury Tabbed Accordion System, Shipping Features Widget, and Share/Help Row
  Usage:
  {% render 'product-tabs', product: product, block: block %}
{% endcomment %}

<tab-system class="tab-system" {{ block.shopify_attributes }}>
  <div class="tab-headers-scroll">
    <div class="tab-headers">
      <button type="button" class="tab-button active" data-tab-id="tab-description-{{ product.id }}">DESCRIPTION</button>
      <button type="button" class="tab-button" data-tab-id="tab-delivery-{{ product.id }}">DELIVERY TIME</button>
      <button type="button" class="tab-button" data-tab-id="tab-exchanges-{{ product.id }}">EXCHANGES</button>
    </div>
  </div>

  <div class="tab-contents">
    <div class="tab-content-inner active" id="tab-description-{{ product.id }}">
      <div class="product-description-rte rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p><strong>{{ product.title }}</strong></p>
          <p>A premium everyday essential built with a textured waffle finish and a relaxed raglan silhouette. Soft, breathable, and designed for effortless streetwear styling.</p>
          <ul>
            <li><strong>260 GSM Waffle Fabric</strong> — Premium textured knit with a substantial feel</li>
            <li><strong>Soft & Breathable</strong> — Comfortable for all-day wear</li>
            <li><strong>DTG Printing</strong> — Crisp, detailed graphics with a smooth finish</li>
            <li><strong>Raglan Sleeves</strong> — Relaxed construction for enhanced mobility</li>
            <li><strong>Boxy Fit</strong> — Modern, structured streetwear silhouette</li>
            <li><strong>Premium Finish</strong> — Versatile and easy to style</li>
          </ul>
        {% endif %}
      </div>
    </div>

    <div class="tab-content-inner" id="tab-delivery-{{ product.id }}">
      <div class="rte">
        <p>We process and dispatch all orders within 24 hours of confirmation. Once shipped, your order will typically be delivered within 3–5 business days, depending on your location. You’ll receive a tracking link via SMS & email as soon as your order is on its way. 🚚📦</p>
      </div>
    </div>

    <div class="tab-content-inner" id="tab-exchanges-{{ product.id }}">
      <div class="rte">
        <p>Not the perfect fit? We’ve got you covered. Enjoy easy exchanges for both size changes and product swaps. Simply raise an exchange request within 7 days of delivery, and our team will help you get the right fit or style with a smooth, hassle-free process. 🔄</p>
      </div>
    </div>
  </div>

  <div class="shipping-features-widget">
    <div class="features-columns">
      <div class="feature-item">
        <div class="feature-icon-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <span class="feature-label">SHIPS IN</span>
        <span class="feature-value">24 Hours</span>
      </div>

      <div class="feature-divider"></div>

      <div class="feature-item">
        <div class="feature-icon-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <span class="feature-label">DELIVERY</span>
        <span class="feature-value">3–5 Days</span>
      </div>

      <div class="feature-divider"></div>

      <div class="feature-item">
        <div class="feature-icon-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <span class="feature-label">EXCHANGE</span>
        <span class="feature-value">Easy 7-Day Exchange</span>
      </div>
    </div>
  </div>

  {% assign current_product_url = shop.url | append: product.url %}
  {% assign current_product_title = product.title | url_encode %}

  <div class="share-and-help-wrapper">
    <div class="social-share-row">
      <span class="share-title">Share:</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ current_product_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      </a>
      <a href="https://twitter.com/intent/tweet?text={{ current_product_title }}&url={{ current_product_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z M4 20l6.768 -6.768 M20 4l-6.768 6.768"></path></svg>
      </a>
      <a href="https://pinterest.com/pin/create/button/?url={{ current_product_url | url_encode }}&media={{ product.featured_image | image_url: width: 800 }}&description={{ current_product_title }}" target="_blank" rel="noopener noreferrer" aria-label="Pin on Pinterest">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
      </a>
      <a href="https://wa.me/?text={{ current_product_title }}%20{{ current_product_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share via WhatsApp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      </a>
      <a href="mailto:?subject={{ current_product_title }}&body={{ current_product_url | url_encode }}" aria-label="Share via Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
      </a>
    </div>

    <a href="https://wa.me/919999999999?text=Hi,%20I%20need%20help%20with%20{{ current_product_title }}" target="_blank" rel="noopener noreferrer" class="help-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      Need help?
    </a>
  </div>
</tab-system>

<style>
  .tab-system {
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
    display: block;
  }
  .tab-headers-scroll {
    overflow-x: auto;
    width: 100%;
    border-bottom: 1px solid rgba(var(--color-foreground-rgb, 255, 255, 255), 0.12);
    -webkit-overflow-scrolling: touch;
  }
  .tab-headers-scroll::-webkit-scrollbar {
    display: none;
  }
  .tab-headers {
    display: flex;
    gap: 28px;
    padding-bottom: 0;
    white-space: nowrap;
  }
  .tab-button {
    background: none;
    border: none;
    padding: 12px 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.5);
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
    font-family: inherit;
  }
  .tab-button:hover {
    color: rgb(var(--color-foreground));
  }
  .tab-button::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: rgb(var(--color-foreground));
    transform: scaleX(0);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .tab-button.active {
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }
  .tab-button.active::after {
    transform: scaleX(1);
  }
  .tab-contents {
    padding-top: 20px;
    padding-bottom: 12px;
  }
  .tab-content-inner {
    display: none;
    opacity: 0;
    transition: opacity 0.25s ease-in-out;
  }
  .tab-content-inner.active {
    display: block;
    opacity: 1;
  }
  .tab-content-inner .rte {
    font-size: 13px;
    line-height: 1.7;
    color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.85);
  }
  .tab-content-inner .rte p {
    margin: 0 0 12px;
  }
  .tab-content-inner .rte strong {
    color: rgb(var(--color-foreground));
  }
  .tab-content-inner .rte ul {
    margin: 0 0 12px;
    padding-left: 20px;
  }
  .tab-content-inner .rte li {
    margin-bottom: 6px;
  }

  /* Shipping & Trust Features Widget */
  .shipping-features-widget {
    border: 1px solid rgba(var(--color-foreground-rgb, 255, 255, 255), 0.1);
    border-radius: 14px;
    padding: 16px 8px;
    background-color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.03);
    margin-top: 16px;
    margin-bottom: 24px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .features-columns {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    justify-items: center;
  }
  .feature-item {
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .feature-icon-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    color: rgb(var(--color-foreground));
  }
  .feature-label {
    font-size: 8px;
    font-weight: 600;
    color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.55);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .feature-value {
    font-size: 11px;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    white-space: nowrap;
  }
  .feature-divider {
    width: 1px;
    height: 38px;
    background-color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.12);
  }

  /* Share & Help Row */
  .share-and-help-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    margin-bottom: 16px;
    padding: 0 4px;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
  }
  .social-share-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .share-title {
    font-size: 13px;
    font-weight: 500;
    color: rgba(var(--color-foreground-rgb, 255, 255, 255), 0.55);
  }
  .social-share-row a {
    color: rgb(var(--color-foreground));
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .social-share-row a:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }
  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgb(var(--color-foreground));
    text-decoration: underline;
    font-weight: 600;
    font-size: 13px;
    transition: opacity 0.2s ease;
  }
  .help-link:hover {
    opacity: 0.75;
  }

  @media screen and (max-width: 480px) {
    .tab-headers {
      gap: 20px;
    }
    .features-columns {
      gap: 2px;
    }
    .feature-value {
      font-size: 10px;
    }
  }
</style>

<script>
  if (!customElements.get('tab-system')) {
    class TabSystem extends HTMLElement {
      connectedCallback() {
        const buttons = this.querySelectorAll('.tab-button');
        const contents = this.querySelectorAll('.tab-content-inner');

        buttons.forEach(button => {
          button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-tab-id');
            buttons.forEach(btn => btn.classList.toggle('active', btn === button));
            contents.forEach(content => {
              content.classList.toggle('active', content.id === targetId);
            });
          });
        });
      }
    }
    customElements.define('tab-system', TabSystem);
  }
</script>
